# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. http://localhost:3000 or production URL).
APP_URL="http://localhost:3000"

# Supabase Configuration
# Get these from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Supabase Service Role Key (SERVER-SIDE ONLY - Railway environment variables)
# Required for Paystack webhook handler to update subscriptions and user status securely.
# NEVER prefix with VITE_ and NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# Paystack Configuration (SERVER-SIDE ONLY - Railway environment variables)
# Secret key used for API requests and HMAC-SHA512 webhook signature verification.
# NEVER prefix with VITE_ and NEVER expose to the frontend.
PAYSTACK_SECRET_KEY="sk_test_..."

# Paystack Plan Codes (SERVER-SIDE ONLY - created in Paystack dashboard)
# e.g. PLN_xxxxxxxxx for monthly, PLN_yyyyyyyyy for annual.
PAYSTACK_MONTHLY_PLAN_CODE=""
PAYSTACK_ANNUAL_PLAN_CODE=""

# Notification Provider Configurations (Optional - In-App works by default)
EMAIL_PROVIDER_API_KEY=""
EMAIL_SENDER_ADDRESS="scholarships@scholavon.org"
PUSH_NOTIFICATION_VAPID_KEY=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

